// bot.js — Telegram-бот с inline-кнопками
const TelegramBot = require("node-telegram-bot-api");
const express = require("express");
const { google } = require("googleapis");

const TELEGRAM_TOKEN = process.env.TELEGRAM_BOT_TOKEN;
const SPREADSHEET_ID = "1wJy1r75VXJGiKdD3fqSGCVVcVifzTB8nClv4tyEsv90";
const SHEET_DATA = "Data";
const SHEET_USERS = "Users";

if (!TELEGRAM_TOKEN) {
  console.error("❌ TELEGRAM_BOT_TOKEN не задан в Secrets");
  process.exit(1);
}

let auth;
let sheets;

try {
  const key = JSON.parse(process.env.GOOGLE_SERVICE_ACCOUNT_KEY);
  auth = new google.auth.GoogleAuth({
    credentials: key,
    scopes: ["https://www.googleapis.com/auth/spreadsheets"], // ← убрал пробелы
  });
  sheets = google.sheets({ version: "v4", auth });
  console.log("✅ Google Sheets: аутентификация успешна");
} catch (err) {
  console.error("❌ Ошибка Google Sheets:", err.message);
  process.exit(1);
}

// === Вспомогательные функции ===
async function getExecutorNameByTelegramId(userId) {
  const response = await sheets.spreadsheets.values.get({
    spreadsheetId: SPREADSHEET_ID,
    range: `${SHEET_USERS}!A:E`,
  });
  const rows = response.data.values || [];
  for (let i = 1; i < rows.length; i++) {
    const telegramId = rows[i][0];
    const executorName = rows[i][3];
    const isActive = rows[i][4];
    const active = isActive === true || isActive === "TRUE" || isActive === "true" || isActive === 1;
    if (String(telegramId) === String(userId) && active) {
      return executorName || "Не указано";
    }
  }
  return "Неизвестный пользователь";
}

async function getAllActiveTasks() {
  const response = await sheets.spreadsheets.values.get({
    spreadsheetId: SPREADSHEET_ID,
    range: `${SHEET_DATA}!A:O`,
  });
  const rows = response.data.values || [];
  if (rows.length < 2) return [];

  const headers = rows[0];
  const idCol = headers.indexOf("ID");
  const taskCol = headers.indexOf("Задача");
  const zoneCol = headers.indexOf("Зона");
  const statusCol = headers.indexOf("Статус");
  const coefCol = headers.indexOf("Коэф_чистоты");

  const tasks = [];
  for (let i = 1; i < rows.length; i++) {
    const row = rows[i];
    const status = row[statusCol] === "TRUE" || row[statusCol] === true;
    if (!status) {
      tasks.push({
        id: String(row[idCol] || i),
        task: row[taskCol] || "Без названия",
        zone: row[zoneCol] || "Не указана",
        coef: parseFloat(row[coefCol]) || 0,
      });
    }
  }
  return tasks.sort((a, b) => a.coef - b.coef);
}

// === Функция: отметить задачу как выполненную ===
async function markTaskAsDone(taskId, executorName) {
  try {
    // === 1. Получаем заголовки ===
    const headersResponse = await sheets.spreadsheets.values.get({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!A1:O1`,
    });
    const headers = (headersResponse.data.values && headersResponse.data.values[0]) || [];

    const idCol = headers.indexOf("ID");
    const taskCol = headers.indexOf("Задача");
    const zoneCol = headers.indexOf("Зона");
    const freqCol = headers.indexOf("Регулярность");
    const statusCol = headers.indexOf("Статус");
    const createdCol = headers.indexOf("Created");
    const dueCol = headers.indexOf("Срок");
    const daysLeftCol = headers.indexOf("Дней до срока");
    const coefCol = headers.indexOf("Коэф_чистоты");
    const execCol = headers.indexOf("Исполнитель");
    const doneDateCol = headers.indexOf("Дата выполнения");

    // Проверка наличия всех колонок
    const requiredCols = { idCol, taskCol, zoneCol, freqCol, statusCol, createdCol, dueCol, execCol, doneDateCol };
    for (const [name, idx] of Object.entries(requiredCols)) {
      if (idx === -1) {
        console.error(`❌ Отсутствует колонка: ${name}`);
        return false;
      }
    }

    // === 2. Получаем все данные ===
    const dataResponse = await sheets.spreadsheets.values.get({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!A:O`,
    });
    const rows = dataResponse.data.values || [];

    // === 3. Находим задачу по ID ===
    let taskRow = null;
    let rowIndex = -1;
    for (let i = 1; i < rows.length; i++) {
      if (String(rows[i][idCol] || "") === String(taskId)) {
        taskRow = rows[i];
        rowIndex = i + 1; // Google Sheets: строки с 1
        break;
      }
    }

    if (!taskRow || rowIndex === -1) {
      console.error(`❌ Задача с ID=${taskId} не найдена`);
      return false;
    }

    // === 4. Обновляем текущую задачу как выполненную ===
    const today = new Date();
    const todayStr = today.toLocaleDateString("ru-RU"); // ДД.ММ.ГГГГ

    await sheets.spreadsheets.values.update({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!${String.fromCharCode(65 + statusCol)}${rowIndex}`,
      valueInputOption: "RAW",
      resource: { values: [["TRUE"]] },
    });

    await sheets.spreadsheets.values.update({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!${String.fromCharCode(65 + execCol)}${rowIndex}`,
      valueInputOption: "RAW",
      resource: { values: [[executorName]] },
    });

    await sheets.spreadsheets.values.update({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!${String.fromCharCode(65 + doneDateCol)}${rowIndex}`,
      valueInputOption: "USER_ENTERED",
      resource: { values: [[todayStr]] },
    });


    // === 5. Создаём новую запись для следующего цикла ===
    const taskText = taskRow[taskCol] || "";
    const zoneText = taskRow[zoneCol] || "";
    const frequency = parseInt(taskRow[freqCol]) || 7;

    const newCreated = todayStr;
    const newDueDate = new Date(today);
    newDueDate.setDate(today.getDate() + frequency);
    const newDueStr = newDueDate.toLocaleDateString("ru-RU");

    // Новый ID = номер следующей строки
    const newId = rows.length;

    // Формируем новую строку
    const newRow = Array(headers.length).fill("");

    newRow[idCol] = newId;
    newRow[taskCol] = taskText;
    newRow[zoneCol] = zoneText;
    newRow[freqCol] = frequency;
    newRow[statusCol] = "FALSE";
    newRow[createdCol] = newCreated;
    newRow[dueCol] = newDueStr;

    // 🔹 ВСТАВЛЯЕМ ФОРМУЛЫ КАК СТРОКИ (начинаются с '=')
    // Дней до срока = МАКС(0; G - СЕГОДНЯ())
    newRow[daysLeftCol] = `=МАКС(0; ${String.fromCharCode(65 + dueCol)}${newId + 1} - СЕГОДНЯ())`;

    // Коэф_чистоты = (H / D) * 100
    newRow[coefCol] = `=ЕСЛИ(${String.fromCharCode(65 + freqCol)}${newId + 1}>0; (${String.fromCharCode(65 + daysLeftCol)}${newId + 1}/${String.fromCharCode(65 + freqCol)}${newId + 1})*100; "")`;

    // Остальные поля — пусто
    newRow[execCol] = "";
    newRow[doneDateCol] = "";

    await sheets.spreadsheets.values.append({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!A:O`,
      valueInputOption: "USER_ENTERED", // ← важно! чтобы Google распознал формулы
      resource: { values: [newRow] },
    });

    console.log(`✅ Задача ID=${taskId} выполнена. Создана новая запись ID=${newId}`);
    return true;
  } catch (err) {
    console.error("⚠️ Ошибка в markTaskAsDone:", err.message);
    return false;
  }
}

async function unmarkTaskAsDone(originalTaskId) {
  try {
    const headersResponse = await sheets.spreadsheets.values.get({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!A1:O1`,
    });
    const headers = (headersResponse.data.values && headersResponse.data.values[0]) || [];

    const idCol = headers.indexOf("ID");
    const statusCol = headers.indexOf("Статус");
    const execCol = headers.indexOf("Исполнитель");
    const doneDateCol = headers.indexOf("Дата выполнения");

    // Получаем все данные
    const dataResponse = await sheets.spreadsheets.values.get({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!A:O`,
    });
    const rows = dataResponse.data.values || [];

    // Находим исходную задачу и удаляем последнюю "дочернюю" запись
    let originalRowIndex = -1;
    let lastChildRowIndex = -1;
    let maxId = -1;

    for (let i = 1; i < rows.length; i++) {
      const row = rows[i];
      const taskId = row[idCol];
      // Предполагаем, что дочерние записи имеют ID > originalTaskId
      if (String(taskId) === String(originalTaskId)) {
        originalRowIndex = i + 1;
      } else if (String(taskId) > String(originalTaskId)) {
        if (parseInt(taskId) > maxId) {
          maxId = parseInt(taskId);
          lastChildRowIndex = i + 1;
        }
      }
    }

    if (originalRowIndex === -1) return false;

    // Восстанавливаем исходную задачу
    await sheets.spreadsheets.values.update({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!${String.fromCharCode(65 + statusCol)}${originalRowIndex}`,
      valueInputOption: "RAW",
      resource: { values: [["FALSE"]] },
    });

    await sheets.spreadsheets.values.update({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!${String.fromCharCode(65 + execCol)}${originalRowIndex}`,
      valueInputOption: "RAW",
      resource: { values: [[""]] },
    });

    await sheets.spreadsheets.values.update({
      spreadsheetId: SPREADSHEET_ID,
      range: `${SHEET_DATA}!${String.fromCharCode(65 + doneDateCol)}${originalRowIndex}`,
      valueInputOption: "RAW",
      resource: { values: [[""]] },
    });

    // Удаляем последнюю дочернюю запись (если найдена)
    if (lastChildRowIndex !== -1) {
      await sheets.spreadsheets.values.clear({
        spreadsheetId: SPREADSHEET_ID,
        range: `${SHEET_DATA}!A${lastChildRowIndex}:O${lastChildRowIndex}`,
      });
    }

    console.log(`✅ Задача ID=${originalTaskId} восстановлена`);
    return true;
  } catch (err) {
    console.error("⚠️ Ошибка в unmarkTaskAsDone:", err.message);
    return false;
  }
}

// === Генерация клавиатур ===
function getZonesKeyboard(zones) {
  const buttons = zones.map(zone => [{ text: `#${zone}`, callback_data: `zone:${zone}` }]);
  buttons.push([{ text: "✅ Все задачи", callback_data: "all" }]);
  return { inline_keyboard: buttons };
}

function getTasksInZoneKeyboard(tasks, currentZone, allZones) {
  const taskButtons = tasks.map(t => [{ text: t.task, callback_data: `task:${t.id}` }]);
  const zoneButtons = allZones
    .filter(z => z !== currentZone)
    .map(z => [{ text: `#${z}`, callback_data: `zone:${z}` }]);
  const back = [{ text: "↩️ Назад к зонам", callback_data: "zones" }];
  return { inline_keyboard: [...taskButtons, ...zoneButtons, back] };
}

function getAllTasksKeyboard(groupedTasks, allZones) {
  const buttons = [];
  for (const [zone, tasks] of Object.entries(groupedTasks)) {
    buttons.push([{ text: `#${zone}`, callback_data: `zone:${zone}` }]);
    tasks.forEach(t => {
      buttons.push([{ text: t.task, callback_data: `task:${t.id}` }]);
    });
  }
  buttons.push([{ text: "↩️ Назад к зонам", callback_data: "zones" }]);
  return { inline_keyboard: buttons };
}

// === Основной бот ===
const bot = new TelegramBot(TELEGRAM_TOKEN, { polling: true });

bot.on("polling_error", (err) => {
  console.error("❌ Polling error:", err.message);
});

// === Команда /start — показывает зоны ===
bot.onText(/\/start/, async (msg) => {
  const chatId = msg.chat.id;
  const tasks = await getAllActiveTasks();
  const zones = [...new Set(tasks.map(t => t.zone))].sort();
  const keyboard = getZonesKeyboard(zones);
  bot.sendMessage(chatId, "Выберите зону или посмотрите все задачи:", { reply_markup: keyboard });
});

// === Обработка нажатий на кнопки ===
bot.on("callback_query", async (callbackQuery) => {
  const msg = callbackQuery.message;
  if (!msg) {
    await bot.answerCallbackQuery(callbackQuery.id, { text: "Сообщение устарело", show_alert: true });
    return;
  }

  const chatId = msg.chat.id;
  const userId = callbackQuery.from.id;
  const data = callbackQuery.data;

  try {
    if (data === "zones") {
      const tasks = await getAllActiveTasks();
      const zones = [...new Set(tasks.map(t => t.zone))].sort();
      const keyboard = getZonesKeyboard(zones);
      await bot.editMessageText("Выберите зону или посмотрите все задачи:", {
        chat_id: chatId,
        message_id: msg.message_id,
        reply_markup: keyboard,
      });
    } else if (data === "all") {
      const tasks = await getAllActiveTasks();
      const grouped = {};
      tasks.forEach(t => {
        if (!grouped[t.zone]) grouped[t.zone] = [];
        grouped[t.zone].push(t);
      });
      const allZones = [...new Set(tasks.map(t => t.zone))].sort();
      const keyboard = getAllTasksKeyboard(grouped, allZones);
      await bot.editMessageText("Все задачи по зонам:", {
        chat_id: chatId,
        message_id: msg.message_id,
        reply_markup: keyboard,
      });
    } else if (data.startsWith("zone:")) {
      const zone = data.split(":")[1];
      const tasks = await getAllActiveTasks();
      const zoneTasks = tasks.filter(t => t.zone === zone);
      const allZones = [...new Set(tasks.map(t => t.zone))].sort();
      const keyboard = getTasksInZoneKeyboard(zoneTasks, zone, allZones);
      await bot.editMessageText(`Задачи в зоне #${zone}:`, {
        chat_id: chatId,
        message_id: msg.message_id,
        reply_markup: keyboard,
      });
    } else if (data.startsWith("task:")) {
      const taskId = data.split(":")[1];
      const executorName = await getExecutorNameByTelegramId(userId);
      const success = await markTaskAsDone(taskId, executorName);

      if (success) {
        await bot.answerCallbackQuery(callbackQuery.id, { text: "✅ Задача выполнена!", show_alert: false });

        const currentKeyboard = msg.reply_markup?.inline_keyboard || [];
        const updatedKeyboard = currentKeyboard.map(row =>
          row.map(button => {
            if (button.callback_data === `task:${taskId}` && !button.text.startsWith("✅ ")) {
              return { ...button, text: `✅ ${button.text}` };
            }
            return button;
          })
        );

        try {
          await bot.editMessageReplyMarkup({
            message_id: msg.message_id,
            chat_id: msg.chat.id,
            reply_markup: { inline_keyboard: updatedKeyboard }
          });
        } catch (err) {
          console.error("Ошибка обновления кнопки:", err.message);
          await bot.sendMessage(chatId, "✅ Задача выполнена! Кнопка не обновлена.");
        }
      } else {
        await bot.answerCallbackQuery(callbackQuery.id, { text: "❌ Ошибка выполнения", show_alert: true });
      }
    }
  } catch (err) {
    console.error("Ошибка в callback_query:", err.message);
    await bot.answerCallbackQuery(callbackQuery.id, { text: "Произошла ошибка", show_alert: true });
  }
});


// === Express для UptimeRobot ===
const app = express();
app.get("/", (req, res) => res.send("✅ Бот работает"));
app.listen(process.env.PORT || 5000, () => {
  console.log("✅ Express сервер запущен");
});